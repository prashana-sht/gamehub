<div class="mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
  <div>
    <h1 class="font-heading font-black text-3xl sm:text-4xl text-white mb-2 flex items-center space-x-3">
      <span>⚡</span>
      <span>RAILS 8 DEFAULTS ENGINE</span>
    </h1>
    <p class="text-slate-400 text-sm">System diagnostic dashboard inspecting Solid Queue, Solid Cache, Solid Cable & Kamal.</p>
  </div>

  <%= button_to system_status_trigger_bot_job_path, method: :post, class: "px-5 py-3 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 font-bold text-xs text-white shadow-lg shadow-purple-600/30 hover:brightness-110 transition-all flex items-center space-x-2" do %>
    <span>🤖 TRIGGER SOLID QUEUE BOT JOB</span>
  <% end %>
</div>

<!-- Stack Overview Cards Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
  <!-- Card 1: Solid Queue -->
  <div class="arcade-card p-6 rounded-3xl border border-cyan-500/40">
    <div class="flex items-center justify-between mb-4">
      <span class="text-3xl">📥</span>
      <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ACTIVE</span>
    </div>
    <h3 class="font-heading font-bold text-xl text-white mb-1">Solid Queue</h3>
    <p class="text-xs text-slate-400 mb-4">DB-backed ActiveJob queue for score processing & AI simulations.</p>

    <div class="space-y-2 pt-2 border-t border-slate-800 font-mono text-xs">
      <div class="flex justify-between text-slate-300">
        <span>Pending Jobs:</span>
        <span class="font-bold text-cyan-400"><%= @pending_jobs_count %></span>
      </div>
      <div class="flex justify-between text-slate-300">
        <span>Failed Jobs:</span>
        <span class="font-bold text-red-400"><%= @failed_jobs_count %></span>
      </div>
    </div>
  </div>

  <!-- Card 2: Solid Cache -->
  <div class="arcade-card p-6 rounded-3xl border border-pink-500/40">
    <div class="flex items-center justify-between mb-4">
      <span class="text-3xl">⚡</span>
      <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ACTIVE</span>
    </div>
    <h3 class="font-heading font-bold text-xl text-white mb-1">Solid Cache</h3>
    <p class="text-xs text-slate-400 mb-4">DB-backed cache replacing Redis with persistent SQLite storage.</p>

    <div class="space-y-2 pt-2 border-t border-slate-800 font-mono text-xs">
      <div class="flex justify-between text-slate-300">
        <span>Cache Entries:</span>
        <span class="font-bold text-pink-400"><%= @cache_entries_count %></span>
      </div>
      <div class="flex justify-between text-slate-300">
        <span>Store Adapter:</span>
        <span class="font-bold text-slate-300">SolidCacheStore</span>
      </div>
    </div>
  </div>

  <!-- Card 3: Solid Cable -->
  <div class="arcade-card p-6 rounded-3xl border border-purple-500/40">
    <div class="flex items-center justify-between mb-4">
      <span class="text-3xl">📡</span>
      <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ACTIVE</span>
    </div>
    <h3 class="font-heading font-bold text-xl text-white mb-1">Solid Cable</h3>
    <p class="text-xs text-slate-400 mb-4">DB-backed ActionCablepub/sub streaming for live leaderboard updates.</p>

    <div class="space-y-2 pt-2 border-t border-slate-800 font-mono text-xs">
      <div class="flex justify-between text-slate-300">
        <span>Messages Broadcast:</span>
        <span class="font-bold text-purple-400"><%= @cable_messages_count %></span>
      </div>
      <div class="flex justify-between text-slate-300">
        <span>Channel:</span>
        <span class="font-bold text-slate-300">leaderboard_stream</span>
      </div>
    </div>
  </div>

  <!-- Card 4: Kamal Deployment -->
  <div class="arcade-card p-6 rounded-3xl border border-amber-500/40">
    <div class="flex items-center justify-between mb-4">
      <span class="text-3xl">🚀</span>
      <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">READY</span>
    </div>
    <h3 class="font-heading font-bold text-xl text-white mb-1">Kamal Deploy</h3>
    <p class="text-xs text-slate-400 mb-4">Zero-downtime Docker container deployment tool included by default.</p>

    <div class="space-y-2 pt-2 border-t border-slate-800 font-mono text-xs">
      <div class="flex justify-between text-slate-300">
        <span>config/deploy.yml:</span>
        <span class="font-bold text-amber-400"><%= @kamal_config_exists ? "PRESENT" : "MISSING" %></span>
      </div>
      <div class="flex justify-between text-slate-300">
        <span>Dockerfile:</span>
        <span class="font-bold text-emerald-400">PRESENT</span>
      </div>
    </div>
  </div>
</div>

<!-- Detailed Solid Queue Job Inspector -->
<div class="arcade-card rounded-3xl p-6 border border-slate-800">
  <h3 class="font-heading font-bold text-lg text-white mb-4 flex items-center space-x-2">
    <span>📋</span>
    <span>RECENT SOLID QUEUE JOBS</span>
  </h3>

  <div class="space-y-2">
    <% @recent_jobs.each do |job| %>
      <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-between text-xs font-mono">
        <div class="flex items-center space-x-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span class="text-cyan-300 font-bold"><%= job.class_name %></span>
          <span class="text-slate-500">Queue: <%= job.queue_name %></span>
        </div>
        <div class="text-slate-400">
          Enqueued <%= time_ago_in_words(job.created_at) %> ago
        </div>
      </div>
    <% end %>

    <% if @recent_jobs.empty? %>
      <div class="text-center py-6 text-slate-500 text-xs font-mono">
        No pending jobs in queue. Submit a score or click "TRIGGER SOLID QUEUE BOT JOB" above!
      </div>
    <% end %>
  </div>
</div>
