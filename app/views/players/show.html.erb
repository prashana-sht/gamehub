<div class="mb-8">
  <%= link_to leaderboards_path, class: "text-xs font-mono text-slate-400 hover:text-cyan-400" do %>
    ← BACK TO LEADERBOARDS
  <% end %>
</div>

<div class="arcade-card rounded-3xl p-8 border border-cyan-500/40 mb-10">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
    <div class="flex items-center space-x-5">
      <div class="w-20 h-20 rounded-3xl bg-slate-900 border border-cyan-500/50 flex items-center justify-center text-4xl shadow-xl shadow-cyan-950/50">
        <%= @player.avatar %>
      </div>
      <div>
        <div class="flex items-center space-x-3">
          <h1 class="font-heading font-black text-3xl text-white"><%= @player.username %></h1>
          <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold"><%= @player.title %></span>
        </div>
        <div class="text-slate-400 text-sm mt-1 flex items-center space-x-4 font-mono">
          <span>Level <%= @player.level %> Player</span>
          <span>•</span>
          <span><%= @player.games_played %> Games Played</span>
        </div>
      </div>
    </div>

    <div class="text-right">
      <div class="text-xs font-mono text-slate-400 uppercase">CAREER SCORE</div>
      <div class="font-heading font-black text-4xl text-cyan-400"><%= number_with_delimiter(@player.total_score) %></div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <!-- Unlocked Badges -->
  <div>
    <h3 class="font-heading font-bold text-xl text-amber-300 mb-4 flex items-center space-x-2">
      <span>🏅</span>
      <span>UNLOCKED BADGES</span>
    </h3>

    <div class="grid grid-cols-1 gap-3">
      <% @achievements.each do |ach| %>
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-amber-500/30 flex items-center space-x-4">
          <span class="text-3xl"><%= Achievement::BADGES[ach.badge_key]&.fetch(:icon) || "🥉" %></span>
          <div>
            <div class="font-bold text-amber-300 text-sm"><%= ach.title %></div>
            <div class="text-xs text-slate-300"><%= ach.description %></div>
            <div class="text-[10px] text-slate-500 font-mono mt-1">Unlocked <%= ach.unlocked_at.strftime("%b %d, %Y") %></div>
          </div>
        </div>
      <% end %>

      <% if @achievements.empty? %>
        <div class="p-6 rounded-2xl bg-slate-900/40 border border-slate-800 text-center text-slate-500 text-sm">
          No badges unlocked yet. Keep playing games in the Arcade!
        </div>
      <% end %>
    </div>
  </div>

  <!-- Recent Game History -->
  <div>
    <h3 class="font-heading font-bold text-xl text-cyan-300 mb-4 flex items-center space-x-2">
      <span>📜</span>
      <span>RECENT MATCH HISTORY</span>
    </h3>

    <div class="space-y-3">
      <% @game_scores.each do |gs| %>
        <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
          <div>
            <div class="font-bold text-sm text-slate-200"><%= GameScore::GAME_TYPES[gs.game_type] || gs.game_type %></div>
            <div class="text-xs text-slate-500 font-mono">Max Combo: <%= gs.max_combo || 0 %>x • Accuracy: <%= (gs.accuracy.to_f * 100).round %>%</div>
          </div>
          <div class="text-right font-mono">
            <div class="font-bold text-cyan-400 text-base">+<%= number_with_delimiter(gs.score) %></div>
            <div class="text-[10px] text-slate-500"><%= time_ago_in_words(gs.created_at) %> ago</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
