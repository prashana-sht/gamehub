<!DOCTYPE html>
<html class="dark">
  <head>
    <title><%= content_for(:title) || "Nexus Arcade - Ruby on Rails 8" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nexus Arcade">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="cyber-bg min-h-screen flex flex-col justify-between" data-controller="sound player-session">
    <!-- ActionCable Turbo Streams Subscriptions -->
    <%= turbo_stream_from "leaderboard_stream" %>
    <%= turbo_stream_from "arcade_feed" %>

    <!-- Header Navbar -->
    <%= render "shared/navbar" %>

    <!-- Live Achievement & Level Up Notifications Drawer -->
    <div id="live_notifications" class="fixed bottom-6 right-6 z-50 max-w-sm w-full pointer-events-none">
      <!-- Turbo stream items prepended here -->
    </div>

    <!-- Main Content Body -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <% if flash[:notice].present? %>
        <div class="mb-6 p-4 rounded-2xl bg-cyan-950/80 border border-cyan-500/40 text-cyan-200 text-sm font-semibold flex items-center justify-between shadow-lg">
          <div class="flex items-center space-x-2">
            <span>⚡</span>
            <span><%= flash[:notice] %></span>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer -->
    <%= render "shared/footer" %>

    <!-- Player Handle Modal -->
    <div data-player-session-target="modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
      <div class="bg-slate-900 border border-cyan-500/40 rounded-3xl p-6 max-w-md w-full shadow-2xl shadow-cyan-950/50 relative animate-bounce-in">
        <button data-action="click->player-session#closeModal" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg">✕</button>

        <div class="flex items-center space-x-3 mb-6">
          <span class="text-3xl">👾</span>
          <div>
            <h3 class="font-heading font-bold text-lg text-white">Arcade Alias Setup</h3>
            <p class="text-xs text-slate-400">Choose your handle and retro avatar for the global leaderboards.</p>
          </div>
        </div>

        <form data-action="submit->player-session#savePlayer" class="space-y-4">
          <div>
            <label class="block text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider mb-2">Arcade Handle</label>
            <input data-player-session-target="usernameInput" type="text" maxlength="20" required class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white font-mono text-sm focus:outline-none focus:border-cyan-400 transition-colors" placeholder="e.g. CyberViper99">
          </div>

          <div>
            <label class="block text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider mb-2">Retro Avatar</label>
            <select data-player-session-target="avatarSelect" class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white text-lg focus:outline-none focus:border-cyan-400 transition-colors">
              <option value="👾">👾 Cyber Alien</option>
              <option value="⚡">⚡ Lightning Striker</option>
              <option value="🕹️">🕹️ Retro Joystick</option>
              <option value="🚀">🚀 Space Explorer</option>
              <option value="🤖">🤖 Cyber Android</option>
              <option value="⚔️">⚔️ Pixel Warrior</option>
              <option value="🔮">🔮 Cyber Mage</option>
              <option value="🐲">🐲 Synth Dragon</option>
            </select>
          </div>

          <div class="pt-4 flex justify-end space-x-3">
            <button type="button" data-action="click->player-session#closeModal" class="px-4 py-2 rounded-xl text-xs font-bold text-slate-400 hover:text-white transition-colors">Cancel</button>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-600 font-bold text-xs text-white shadow-lg shadow-cyan-500/30 hover:brightness-110 transition-all">Save Profile</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
